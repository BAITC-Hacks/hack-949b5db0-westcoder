    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/hackathon/hack-949b5db0-westcoder",
      "program": "c:/hackathon/hack-949b5db0-westcoder/build/Debug/outDebug",
      "MIMode": "gdb",
