{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EventMatch: Run",
      "type": "process",
      "command": "python",
      "args": ["-m", "backend.server"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "EventMatch: Tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
