HOST=127.0.0.1
PORT=8000
# Optional. No external calls until both options are set.
ENABLE_EMBEDDINGS=false
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# AI brief extraction via Responses API. Uses the server-side key above.
# Without a key the brief still works using local rules, clearly labeled in the UI.
ENABLE_AI_BRIEF=false
BRIEF_MODEL=gpt-4.1-mini
